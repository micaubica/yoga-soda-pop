# Full WooCommerce product URL for the backpack.
# Example: https://shop.example.com/product/kpop-demon-hunters-backpack/
NEXT_PUBLIC_WOOCOMMERCE_PRODUCT_URL=

# Pop Club signup email delivery (Resend).
# Keep RESEND_API_KEY server-side only; never prefix it with NEXT_PUBLIC_.
RESEND_API_KEY=

# The sender must belong to a domain verified in Resend.
POP_CLUB_FROM_EMAIL=Yoga Soda Pop <hello@yogasodapop.com>

# Where new signup notifications are delivered.
POP_CLUB_TO_EMAIL=yogasodapop@gmail.com

# Public Tawk.to widget identifiers (not passwords or API keys).
# Both must be set before building the static site to enable live chat.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=
